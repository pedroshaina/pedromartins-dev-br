---
import '@/styles/global.css';
import TopBar from '@/components/layout/TopBar.astro';
import Footer from '@/components/layout/Footer.astro';
import Seo from '@/components/common/Seo.astro';
import { defaultLocale, languageTag, localizedPath, locales, type Locale } from '@/i18n/locales';
import { t } from '@/i18n/ui';

interface Props {
  title: string;
  description: string;
  locale: Locale;
  /** Where the language switch goes, when it isn't this page's path in the other language (404s). */
  switchPaths?: Record<Locale, string>;
  /** Pages that aren't real addresses (404s): no hreflang alternates, not indexed. */
  noindex?: boolean;
  type?: 'website' | 'article';
  publishedTime?: Date;
  /** Scroll snaps a whole screen at a time (home page). */
  snap?: boolean;
}

const {
  title,
  description,
  locale,
  switchPaths,
  noindex = false,
  type,
  publishedTime,
  snap = false,
} = Astro.props;
const s = t(locale);
const alternates = locales.map((l) => ({
  hreflang: languageTag[l],
  href: new URL(localizedPath(Astro.url.pathname, l), Astro.site).href,
}));
const xDefault = new URL(localizedPath(Astro.url.pathname, defaultLocale), Astro.site).href;
---

<!doctype html>
<html lang={languageTag[locale]} class:list={[{ snap }]}>
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <link rel="icon" type="image/svg+xml" href="/favicon.svg" />
    <link rel="icon" href="/favicon.ico" />
    <title>{title}</title>
    <meta name="description" content={description} />
    <Seo
      title={title}
      description={description}
      locale={locale}
      type={type}
      publishedTime={publishedTime}
    />
    <link
      rel="alternate"
      type="application/rss+xml"
      title={s.rss.title}
      href={localizedPath('/rss.xml', locale)}
    />
    {noindex && <meta name="robots" content="noindex" />}
    {!noindex && alternates.map((a) => <link rel="alternate" hreflang={a.hreflang} href={a.href} />)}
    {!noindex && <link rel="alternate" hreflang="x-default" href={xDefault} />}
  </head>
  <body>
    <TopBar locale={locale} switchPaths={switchPaths} />
    <main>
      <slot />
    </main>
    <Footer />
  </body>
</html>
