---
import type { GetStaticPaths } from 'astro';
import BlogIndexPage from '../../../components/blog/BlogIndexPage.astro';
import { getPosts, getProjects, type Project } from '../../../lib/content';

// Only projects with 2+ posts get a list; with one, the home page links straight to the post.
export const getStaticPaths = (async () => {
  const [posts, projects] = await Promise.all([getPosts('en'), getProjects('en')]);
  return projects
    .filter((project) => posts.filter((p) => p.entry.data.project === project.slug).length >= 2)
    .map((project) => ({ params: { project: project.slug }, props: { project } }));
}) satisfies GetStaticPaths;

const { project } = Astro.props as { project: Project };
---

<BlogIndexPage locale="en" project={project} />
