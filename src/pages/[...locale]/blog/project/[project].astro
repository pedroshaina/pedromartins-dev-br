---
import type { GetStaticPaths } from 'astro';
import BlogIndexPage from '@/components/blog/BlogIndexPage.astro';
import { localePaths, type Locale } from '@/i18n/locales';
import { getPosts, getProjects, type Project } from '@/lib/content';

// Every project with a post gets a list; the badges on the blog page link to it.
export const getStaticPaths = (async () => {
  const paths = await Promise.all(
    localePaths().map(async ({ params, props }) => {
      const [posts, projects] = await Promise.all([
        getPosts(props.locale),
        getProjects(props.locale),
      ]);
      return projects
        .filter((project) => posts.some((p) => p.entry.data.project === project.slug))
        .map((project) => ({
          params: { ...params, project: project.slug },
          props: { ...props, project },
        }));
    }),
  );
  return paths.flat();
}) satisfies GetStaticPaths;

const { locale, project } = Astro.props as { locale: Locale; project: Project };
---

<BlogIndexPage locale={locale} project={project} />
