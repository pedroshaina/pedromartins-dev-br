---
import type { GetStaticPaths } from 'astro';
import BlogIndexPage from '@/components/blog/BlogIndexPage.astro';
import { localePaths, type Locale } from '@/i18n/locales';

export const getStaticPaths = (() => localePaths()) satisfies GetStaticPaths;

const { locale } = Astro.props as { locale: Locale };
---

<BlogIndexPage locale={locale} />
