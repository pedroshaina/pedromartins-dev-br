---
import type { GetStaticPaths } from 'astro';
import PostPage from '../../../components/blog/PostPage.astro';
import { localePaths, type Locale } from '../../../i18n/locales';
import { getPosts, type Post } from '../../../lib/content';

export const getStaticPaths = (async () => {
  const paths = await Promise.all(
    localePaths().map(async ({ params, props }) =>
      (await getPosts(props.locale)).map((post) => ({
        params: { ...params, slug: post.slug },
        props: { ...props, post },
      })),
    ),
  );
  return paths.flat();
}) satisfies GetStaticPaths;

const { locale, post } = Astro.props as { locale: Locale; post: Post };
---

<PostPage locale={locale} post={post} />
