---
import BaseLayout from '../layouts/BaseLayout.astro';
import { site } from '../config/site';
---

<BaseLayout title={site.name} description="Senior software engineer.">
  <section class="intro">
    <h1>{site.name}</h1>
    <p>Placeholder intro: senior software engineer, 12+ years across industries.</p>
    <p lang="pt-BR">Ação, coração, informações, café, você.</p>
  </section>
</BaseLayout>

<style>
  .intro {
    display: flex;
    flex-direction: column;
    align-items: center;
    justify-content: center;
    min-height: 70vh;
    text-align: center;
    padding: 0 16px;
  }

  h1 {
    font-size: 28px;
    margin: 0 0 8px;
  }

  p {
    max-width: 340px;
    margin: 0 0 8px;
  }
</style>
