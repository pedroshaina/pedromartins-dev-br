---
import SectionTitle from './SectionTitle.astro';
import type { Locale } from '../../i18n/locales';
import { t } from '../../i18n/ui';
import { projectBlogHref, type Post, type Project } from '../../lib/content';

interface Props {
  locale: Locale;
  projects: Project[];
  posts: Post[];
}

const { locale, projects, posts } = Astro.props;
const s = t(locale);
---

<section id="projects" class="screen">
  <div class="col">
    <div class="heading"><SectionTitle>{s.home.projectsLabel}</SectionTitle></div>
    <ul class="projects">
      {
        projects.map((project) => {
          const blogHref = projectBlogHref(project, posts, locale);
          return (
            <li class="project">
              <div class="head">
                <h3>{project.title}</h3>
                {project.repo && (
                  <a class="ext" href={project.repo} target="_blank" rel="noopener">
                    {s.project.github}
                  </a>
                )}
                {project.website && (
                  <a class="ext" href={project.website} target="_blank" rel="noopener">
                    {s.project.website}
                  </a>
                )}
              </div>
              <p>{project.summary}</p>
              {blogHref && (
                <a class="blog" href={blogHref}>
                  {s.project.readOnBlog}
                </a>
              )}
            </li>
          );
        })
      }
    </ul>
  </div>
</section>

<style>
  .screen {
    min-height: 100svh;
    display: flex;
    align-items: center;
    padding: 64px 16px;
    scroll-snap-align: start;
    scroll-snap-stop: always;
  }

  /* The last screen shares the window with the footer, which is where it snaps. */
  .screen:last-child {
    min-height: calc(100svh - var(--footer-height));
    scroll-snap-align: none;
  }

  .col {
    width: 100%;
    max-width: 860px;
    margin: 0 auto;
  }

  .heading {
    margin-bottom: 16px;
  }

  /* Two equal columns; an odd last project leaves the right cell empty. */
  .projects {
    display: grid;
    gap: 36px 56px;
    list-style: none;
    margin: 0;
    padding: 0;
  }

  @media (min-width: 720px) {
    .projects {
      grid-template-columns: repeat(2, minmax(0, 1fr));
    }
  }

  .project {
    padding-bottom: 20px;
    border-bottom: 1px solid rgba(255, 255, 255, 0.1);
  }

  .head {
    display: flex;
    flex-wrap: wrap;
    align-items: baseline;
    column-gap: 14px;
    margin-bottom: 8px;
  }

  h3 {
    font-size: 28px;
    line-height: 1.15;
    margin: 0;
    transition: color 0.2s, text-shadow 0.2s;
  }

  .project:hover h3,
  .project:focus-within h3 {
    color: var(--color-cyan);
    text-shadow: 0 0 10px rgba(5, 217, 232, 0.5);
  }

  .ext {
    font-size: 13px;
    color: var(--color-dim);
    text-decoration: none;
    border-bottom: 1px solid rgba(255, 255, 255, 0.18);
  }

  p {
    margin: 0 0 10px;
    line-height: 1.65;
  }

  .blog {
    font-size: 15px;
    color: var(--color-cyan);
    text-decoration: none;
  }
</style>
