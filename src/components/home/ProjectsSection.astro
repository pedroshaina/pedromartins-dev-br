---
import type { Locale } from '../../i18n/locales';
import { t } from '../../i18n/ui';
import { projectBlogHref, type Post, type Project } from '../../lib/content';

interface Props {
  locale: Locale;
  projects: Project[];
  posts: Post[];
}

const { locale, projects, posts } = Astro.props;
const s = t(locale);
---

<section id="projects" class="screen">
  <div class="col">
    <h2 class="label">{s.home.projectsLabel}</h2>
    <ul class="projects">
      {
        projects.map((project) => {
          const blogHref = projectBlogHref(project, posts, locale);
          return (
            <li class="project">
              <div class="title">
                <h3>{project.title}</h3>
                {project.repo && (
                  <a class="ext" href={project.repo} target="_blank" rel="noopener">
                    {s.project.github}
                  </a>
                )}
                {project.website && (
                  <a class="ext" href={project.website} target="_blank" rel="noopener">
                    {s.project.website}
                  </a>
                )}
              </div>
              <p>{project.summary}</p>
              {blogHref && (
                <a class="blog" href={blogHref}>
                  {s.project.readOnBlog}
                </a>
              )}
            </li>
          );
        })
      }
    </ul>
  </div>
</section>

<style>
  .screen {
    padding: 64px 16px;
  }

  @media (min-width: 720px) and (min-height: 600px) {
    .screen {
      min-height: 100svh;
      display: flex;
      align-items: center;
    }
  }

  .col {
    width: 100%;
    max-width: 640px;
    margin: 0 auto;
  }

  .label {
    font-family: var(--font-mono);
    font-weight: 400;
    font-size: 12px;
    letter-spacing: 0.24em;
    text-transform: uppercase;
    color: var(--color-magenta);
    margin: 0 0 28px;
  }

  .projects {
    list-style: none;
    margin: 0;
    padding: 0;
  }

  .project {
    padding: 22px 0;
    border-top: 1px solid rgba(255, 255, 255, 0.08);
  }

  .project:last-child {
    border-bottom: 1px solid rgba(255, 255, 255, 0.08);
  }

  .title {
    display: flex;
    flex-wrap: wrap;
    align-items: baseline;
    column-gap: 16px;
    margin-bottom: 6px;
  }

  h3 {
    font-size: 22px;
    line-height: 1.3;
    margin: 0;
    transition: color 0.2s, text-shadow 0.2s;
  }

  .project:hover h3,
  .project:focus-within h3 {
    color: var(--color-cyan);
    text-shadow: 0 0 10px rgba(5, 217, 232, 0.5);
  }

  .ext {
    font-size: 13px;
    letter-spacing: 0.04em;
    color: var(--color-dim);
    text-decoration: none;
    border-bottom: 1px solid rgba(255, 255, 255, 0.15);
  }

  p {
    margin: 0 0 10px;
  }

  .blog {
    font-size: 14px;
    letter-spacing: 0.04em;
    color: var(--color-cyan);
    text-decoration: none;
  }
</style>
