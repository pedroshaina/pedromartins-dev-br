---
import Heading from '@/components/common/Heading.astro';

interface Props {
  id: string;
  title: string;
  width: number;
}

const { id, title, width } = Astro.props;
---

<section id={id} class="screen">
  <div class="col" style={`--width: ${width}px`}>
    <Heading>{title}</Heading>
    <slot />
  </div>
  <div class="end" aria-hidden="true"></div>
</section>

<style>
  /* A screen taller than the window scrolls freely between its top and bottom snap points.
     Both stop a fling, so leaving a screen always takes a separate swipe. */
  .screen {
    position: relative;
    min-height: 100svh;
    display: flex;
    align-items: center;
    padding: 64px 16px;
    scroll-snap-align: start;
    scroll-snap-stop: always;
  }

  .end {
    position: absolute;
    bottom: 0;
    left: 0;
    width: 100%;
    height: 0;
    scroll-snap-align: end;
    scroll-snap-stop: always;
  }

  /* The last screen shares the window with the footer, which is its bottom snap point. */
  .screen:last-child {
    min-height: calc(100svh - var(--footer-height));
  }

  .screen:last-child .end {
    display: none;
  }

  .col {
    width: 100%;
    max-width: var(--width);
    margin: 0 auto;
  }
</style>
