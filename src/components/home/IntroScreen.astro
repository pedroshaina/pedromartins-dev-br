---
import Avatar from '../Avatar.astro';
import { site } from '../../config/site';
import type { Locale } from '../../i18n/locales';
import { t } from '../../i18n/ui';

interface Props {
  locale: Locale;
}

const s = t(Astro.props.locale);
---

<section class="intro">
  <div class="mid">
    <Avatar size={92} />
    <h1>{site.name}</h1>
    <div class="text">
      {s.home.intro.map((paragraph) => <p>{paragraph}</p>)}
    </div>
    <ul class="links">
      <li><a href={site.links.github}>GitHub</a></li>
      <li><a href={site.links.linkedin}>LinkedIn</a></li>
      <li><a href={site.links.email}>Email</a></li>
    </ul>
  </div>
  <p class="hint" aria-hidden="true">{s.home.scrollHint}</p>
</section>

<style>
  .intro {
    /* roughly one screen under the top bar */
    min-height: calc(100svh - 70px);
    display: flex;
    flex-direction: column;
    padding: 0 16px 24px;
  }

  .mid {
    flex: 1;
    display: flex;
    flex-direction: column;
    align-items: center;
    justify-content: center;
    text-align: center;
  }

  h1 {
    font-size: 28px;
    line-height: 1.2;
    margin: 18px 0 0;
  }

  .text {
    max-width: 520px;
    margin: 10px 0 16px;
  }

  .text p {
    margin: 0 0 10px;
  }

  .text p:last-child {
    margin-bottom: 0;
  }

  .links {
    display: flex;
    gap: 22px;
    list-style: none;
    margin: 0;
    padding: 0;
    font-size: 14px;
    letter-spacing: 0.06em;
  }

  .links a {
    color: var(--color-emphasis);
    text-decoration: none;
    border-bottom: 1px solid rgba(255, 42, 109, 0.6);
  }

  .hint {
    max-width: none;
    margin: 0;
    text-align: center;
    font-family: var(--font-mono);
    font-size: 11px;
    letter-spacing: 0.2em;
    text-transform: uppercase;
    color: var(--color-dim);
  }
</style>
