---
import Avatar from './Avatar.astro';
import { site } from '@/config/site';
import type { Locale } from '@/i18n/locales';
import { t } from '@/i18n/ui';

interface Props {
  locale: Locale;
}

const s = t(Astro.props.locale);
---

<section class="intro">
  <div class="mid">
    <Avatar size={132} />
    <h1>{site.name}</h1>
    <div class="text">
      {s.home.intro.map((paragraph) => <p>{paragraph}</p>)}
    </div>
    <ul class="links">
      <li><a href={site.links.github} target="_blank">GitHub</a></li>
      <li><a href={site.links.linkedin} target="_blank">LinkedIn</a></li>
      <li><a href={site.links.email}>Email</a></li>
    </ul>
  </div>
  <a class="hint" href="#stack">{s.home.scrollHint}<span aria-hidden="true">↓</span></a>
</section>

<style>
  .intro {
    /* roughly one screen under the top bar */
    min-height: calc(100svh - 70px);
    display: flex;
    flex-direction: column;
    padding: 0 16px 16px;
  }

  .mid {
    flex: 1;
    display: flex;
    flex-direction: column;
    align-items: center;
    justify-content: center;
    text-align: center;
  }

  h1 {
    font-weight: 600;
    font-size: clamp(36px, 9vw, 64px);
    line-height: 1.05;
    margin: 26px 0 20px;
  }

  .text {
    max-width: 60ch;
    font-size: 18px;
  }

  .text p {
    margin: 0 0 12px;
  }

  /* The intro runs three paragraphs; on a phone it must still leave room for the hint. */
  @media (max-width: 719px) {
    h1 {
      margin: 20px 0 16px;
    }

    .text {
      font-size: 16px;
    }
  }

  .links {
    display: flex;
    gap: 26px;
    list-style: none;
    margin: 10px 0 0;
    padding: 0;
    font-size: 15px;
  }

  .links a {
    color: var(--color-emphasis);
    text-decoration: none;
    border-bottom: 1px solid rgba(255, 42, 109, 0.6);
  }

  .hint {
    align-self: center;
    margin-top: 16px;
    display: inline-flex;
    flex-direction: column;
    align-items: center;
    gap: 2px;
    padding: 10px 22px;
    font-size: 13px;
    letter-spacing: 0.04em;
    color: var(--color-emphasis);
    text-decoration: none;
    animation: nudge 1.8s ease-in-out infinite;
  }

  .hint span {
    font-size: 16px;
    line-height: 1;
    color: var(--color-magenta);
    text-shadow: 0 0 8px rgba(255, 42, 109, 0.6);
    transition: color 0.2s, text-shadow 0.2s;
  }

  .hint:hover,
  .hint:focus-visible {
    animation-play-state: paused;
  }

  .hint:hover span,
  .hint:focus-visible span {
    color: var(--color-cyan);
    text-shadow: 0 0 10px rgba(5, 217, 232, 0.6);
  }

  @keyframes nudge {
    0%,
    55%,
    100% {
      transform: translateY(0);
    }
    25% {
      transform: translateY(7px);
    }
    40% {
      transform: translateY(2px);
    }
  }
</style>
