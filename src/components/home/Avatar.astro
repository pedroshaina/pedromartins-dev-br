---
import AvatarImage from '@/assets/avatar.svg';
import { site } from '@/config/site';

interface Props {
  size: number;
}

const { size } = Astro.props;
---

<div class="avatar" style={`--size: ${size}px`}>
  <AvatarImage width={size} height={size} role="img" aria-label={site.name} />
</div>

<style>
  .avatar {
    width: var(--size);
    height: var(--size);
    border-radius: 50%;
    border: 1px solid var(--color-magenta);
    box-shadow: 0 0 18px var(--color-magenta-glow);
    background: #0c142e;
    display: flex;
    align-items: center;
    justify-content: center;
    overflow: hidden;
    flex-shrink: 0;
  }
</style>
