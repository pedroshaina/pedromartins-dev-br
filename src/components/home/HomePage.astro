---
import BaseLayout from '@/layouts/BaseLayout.astro';
import IntroScreen from './IntroScreen.astro';
import StackSection from './StackSection.astro';
import ProjectsSection from './ProjectsSection.astro';
import { site } from '@/config/site';
import type { Locale } from '@/i18n/locales';
import { t } from '@/i18n/ui';
import { getPosts, getProjects } from '@/lib/content';

interface Props {
  locale: Locale;
}

const { locale } = Astro.props;
const s = t(locale);
const [posts, projects] = await Promise.all([getPosts(locale), getProjects(locale)]);
---

<BaseLayout title={site.title} description={s.home.description} locale={locale} snap>
  <IntroScreen locale={locale} />
  <StackSection locale={locale} />
  <ProjectsSection locale={locale} projects={projects} posts={posts} />
</BaseLayout>
