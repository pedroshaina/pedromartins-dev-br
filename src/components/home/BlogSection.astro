---
import { formatDate, localizedPath, type Locale } from '../../i18n/locales';
import { t } from '../../i18n/ui';
import { postHref, type Post } from '../../lib/content';

interface Props {
  locale: Locale;
  posts: Post[];
}

const { locale, posts } = Astro.props;
const s = t(locale);
const latest = posts.slice(0, 3);
---

<section class="screen">
  <div class="col">
    <h2 class="label">{s.home.blogLabel}</h2>
    <ul class="posts">
      {
        latest.map((post) => (
          <li class="post">
            <a href={postHref(post)}>{post.entry.data.title}</a>
            <time datetime={post.entry.data.pubDate.toISOString()}>
              {formatDate(post.entry.data.pubDate, locale)}
            </time>
          </li>
        ))
      }
    </ul>
    <a class="all" href={localizedPath('/blog/', locale)}>{s.home.allPosts}</a>
  </div>
</section>

<style>
  .screen {
    min-height: 100svh;
    display: flex;
    align-items: center;
    padding: 64px 16px;
    scroll-snap-align: start;
    scroll-snap-stop: always;
  }

  /* The last screen shares the window with the footer, which is where it snaps. */
  .screen:last-child {
    min-height: calc(100svh - var(--footer-height));
    scroll-snap-align: none;
  }

  .col {
    width: 100%;
    max-width: 640px;
    margin: 0 auto;
  }

  .label {
    font-family: var(--font-mono);
    font-weight: 400;
    font-size: 12px;
    letter-spacing: 0.24em;
    text-transform: uppercase;
    color: var(--color-magenta);
    margin: 0 0 28px;
  }

  .posts {
    list-style: none;
    margin: 0;
    padding: 0;
  }

  .post {
    display: flex;
    justify-content: space-between;
    align-items: baseline;
    gap: 20px;
    padding: 12px 0;
    border-bottom: 1px solid rgba(255, 255, 255, 0.05);
  }

  .post a {
    color: var(--color-emphasis);
    text-decoration: none;
  }

  time {
    font-family: var(--font-mono);
    font-size: 13px;
    color: var(--color-dim);
    white-space: nowrap;
  }

  .all {
    display: inline-block;
    margin-top: 18px;
    font-size: 14px;
    color: var(--color-emphasis);
    text-decoration: none;
    border-bottom: 1px solid rgba(255, 42, 109, 0.6);
  }
</style>
