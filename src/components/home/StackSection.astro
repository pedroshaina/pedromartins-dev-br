---
import SectionTitle from './SectionTitle.astro';
import { stack } from '@/config/stack';
import type { Locale } from '@/i18n/locales';
import { t } from '@/i18n/ui';

interface Props {
  locale: Locale;
}

const { locale } = Astro.props;
const s = t(locale);
---

<section id="stack" class="screen">
  <div class="col">
    <SectionTitle>{s.home.stackLabel}</SectionTitle>
    <dl class="grid">
      {
        stack.map((category) => (
          <div>
            <dt>{category.label[locale]}</dt>
            <dd>{category.items.join(', ')}</dd>
          </div>
        ))
      }
    </dl>
  </div>
</section>

<style>
  .screen {
    min-height: 100svh;
    display: flex;
    align-items: center;
    padding: 64px 16px;
    scroll-snap-align: start;
    scroll-snap-stop: always;
  }

  .col {
    width: 100%;
    max-width: 640px;
    margin: 0 auto;
  }

  .grid {
    display: grid;
    gap: 28px 32px;
    margin: 0;
    text-align: center;
  }

  @media (min-width: 720px) {
    .grid {
      grid-template-columns: repeat(3, minmax(0, 1fr));
    }
  }

  dt {
    font-family: var(--font-heading);
    font-weight: 500;
    font-size: 16px;
    line-height: 1.4;
    color: var(--color-emphasis);
    margin: 0 0 6px;
  }

  dd {
    margin: 0;
    font-size: 15px;
    line-height: 1.65;
  }
</style>
