---
import Screen from './Screen.astro';
import { stack } from '@/config/stack';
import type { Locale } from '@/i18n/locales';
import { t } from '@/i18n/ui';

interface Props {
  locale: Locale;
}

const { locale } = Astro.props;
const s = t(locale);
---

<Screen id="stack" title={s.home.stackLabel} width={640}>
  <dl class="grid">
    {
      stack.map((category) => (
        <div>
          <dt>{category.label[locale]}</dt>
          <dd>{category.items.join(', ')}</dd>
        </div>
      ))
    }
  </dl>
</Screen>

<style>
  .grid {
    display: grid;
    gap: 28px 32px;
    margin: 0;
    text-align: center;
  }

  @media (min-width: 720px) {
    .grid {
      grid-template-columns: repeat(3, minmax(0, 1fr));
    }
  }

  dt {
    font-family: var(--font-heading);
    font-weight: 500;
    font-size: 16px;
    line-height: 1.4;
    color: var(--color-emphasis);
    margin: 0 0 6px;
  }

  dd {
    margin: 0;
    font-size: 15px;
    line-height: 1.65;
  }
</style>
