---
import { stack } from '../../config/stack';
import type { Locale } from '../../i18n/locales';
import { t } from '../../i18n/ui';

interface Props {
  locale: Locale;
}

const { locale } = Astro.props;
const s = t(locale);
---

<section class="screen">
  <div class="col">
    <h2 class="label">{s.home.stackLabel}</h2>
    <div class="grid">
      {
        stack.map((category) => (
          <div class:list={['category', { wide: category.wide }]}>
            <h3>{category.label[locale]}</h3>
            <ul>
              {category.items.map((item) => (
                <li>{item}</li>
              ))}
            </ul>
          </div>
        ))
      }
    </div>
  </div>
</section>

<style>
  .screen {
    min-height: 100svh;
    display: flex;
    align-items: center;
    padding: 64px 16px;
    scroll-snap-align: start;
    scroll-snap-stop: always;
  }

  .col {
    width: 100%;
    max-width: 640px;
    margin: 0 auto;
  }

  .label {
    font-family: var(--font-mono);
    font-weight: 400;
    font-size: 12px;
    letter-spacing: 0.24em;
    text-transform: uppercase;
    color: var(--color-magenta);
    margin: 0 0 28px;
  }

  .grid {
    display: grid;
    gap: 20px 32px;
  }

  @media (min-width: 560px) {
    .grid {
      grid-template-columns: 1fr 1fr;
    }

    .wide {
      grid-column: 1 / -1;
    }
  }

  h3 {
    font-family: var(--font-mono);
    font-weight: 400;
    font-size: 11px;
    line-height: 1.4;
    letter-spacing: 0.16em;
    text-transform: uppercase;
    color: var(--color-dim);
    margin: 0 0 8px;
  }

  ul {
    display: flex;
    flex-wrap: wrap;
    gap: 6px;
    list-style: none;
    margin: 0;
    padding: 0;
  }

  li {
    font-size: 13px;
    line-height: 1.8;
    color: var(--color-emphasis);
    border: 1px solid rgba(5, 217, 232, 0.28);
    border-radius: 3px;
    padding: 0 8px;
  }
</style>
