---
import { site } from '../config/site';
import { localizedPath, type Locale } from '../i18n/locales';
import { t } from '../i18n/ui';
import { getPosts } from '../lib/content';

interface Props {
  locale: Locale;
  switchPaths?: Record<Locale, string>;
}

const { locale, switchPaths } = Astro.props;
const s = t(locale);
const path = Astro.url.pathname;
const blogPath = localizedPath('/blog/', locale);
// No link until there's a post to read (drafts count in dev), nor inside the blog itself.
const showBlog = (await getPosts(locale)).length > 0 && !path.startsWith(blogPath);
const switchItems = [
  { locale: 'en', label: 'EN', lang: 'en' },
  { locale: 'pt-br', label: 'PT', lang: 'pt-BR' },
] as const;
---

<header class="top">
  <a class="brand" href={localizedPath('/', locale)}>{site.initials}</a>
  <nav aria-label="Site">
    {showBlog && <a href={blogPath}>{s.nav.blog}</a>}
    <span class="lang" role="group" aria-label={s.nav.language}>
      {
        switchItems.map((item, i) => (
          <>
            {i > 0 && <span aria-hidden="true"> | </span>}
            {item.locale === locale ? (
              <span class="current" aria-current="true">{item.label}</span>
            ) : (
              <a href={switchPaths?.[item.locale] ?? localizedPath(path, item.locale)} hreflang={item.lang} lang={item.lang}>
                {item.label}
              </a>
            )}
          </>
        ))
      }
    </span>
  </nav>
</header>

<style>
  .top {
    display: flex;
    justify-content: space-between;
    align-items: center;
    padding: 22px 30px;
    font-family: var(--font-heading);
    font-size: 13px;
    letter-spacing: 0.08em;
    color: var(--color-dim);
    /* first snap point on pages that snap */
    scroll-snap-align: start;
    scroll-snap-stop: always;
  }

  a {
    color: var(--color-emphasis);
    text-decoration: none;
  }

  .brand {
    font-weight: 600;
    letter-spacing: 0.4em;
  }

  nav {
    display: flex;
    gap: 1.6em;
    align-items: center;
  }

  .current {
    color: var(--color-dim);
  }

  @media (max-width: 480px) {
    .top {
      padding: 18px 16px;
    }
  }
</style>
