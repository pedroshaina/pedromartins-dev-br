---
import { formatDate, type Locale } from '../../i18n/locales';
import { t } from '../../i18n/ui';
import { postHref, type Post } from '../../lib/content';

interface Props {
  posts: Post[];
  locale: Locale;
  order: 'newest' | 'oldest';
  /** Label each post "Part N": for a project's posts, which read as a series. */
  numbered?: boolean;
}

const { posts, locale, order, numbered = false } = Astro.props;
const s = t(locale);
const sorted = [...posts].sort((a, b) => {
  const d = a.entry.data.pubDate.getTime() - b.entry.data.pubDate.getTime();
  return order === 'oldest' ? d : -d;
});
---

<ul class="posts">
  {
    sorted.map((post, i) => (
      <li class="post">
        <div class="head">
          {numbered && <span class="part">{s.post.part(i + 1)}</span>}
          <a href={postHref(post)}>{post.entry.data.title}</a>
        </div>
        <time datetime={post.entry.data.pubDate.toISOString()}>
          {formatDate(post.entry.data.pubDate, locale)}
        </time>
        <p>{post.entry.data.description}</p>
      </li>
    ))
  }
</ul>

<style>
  .posts {
    list-style: none;
    margin: 0;
    padding: 0;
  }

  .post {
    display: grid;
    grid-template-columns: minmax(0, 1fr) auto;
    column-gap: 24px;
    padding: 20px 0;
    border-bottom: 1px solid rgba(255, 255, 255, 0.06);
  }

  .post:first-child {
    padding-top: 0;
  }

  .part {
    display: block;
    font-family: var(--font-mono);
    font-size: 13px;
    color: var(--color-magenta);
    margin-bottom: 4px;
  }

  a {
    font-family: var(--font-heading);
    font-weight: 500;
    font-size: 22px;
    line-height: 1.25;
    color: var(--color-heading);
    text-decoration: none;
  }

  time {
    font-family: var(--font-mono);
    font-size: 13px;
    color: var(--color-dim);
    white-space: nowrap;
    padding-top: 6px;
  }

  p {
    grid-column: 1;
    max-width: 64ch;
    margin: 6px 0 0;
    font-size: 15.5px;
  }

  /* With a Part label above the title, the date lines up with the title instead. */
  .head:has(.part) + time {
    padding-top: 30px;
  }

  @media (max-width: 480px) {
    .post {
      grid-template-columns: minmax(0, 1fr);
    }

    time {
      grid-row: 1;
      padding-top: 0;
    }

    .head:has(.part) + time {
      padding-top: 0;
    }
  }
</style>
