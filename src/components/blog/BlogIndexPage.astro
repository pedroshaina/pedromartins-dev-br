---
import BaseLayout from '@/layouts/BaseLayout.astro';
import PostList from './PostList.astro';
import Heading from '@/components/common/Heading.astro';
import { site } from '@/config/site';
import { localizedPath, type Locale } from '@/i18n/locales';
import { t } from '@/i18n/ui';
import { getPosts, type Project } from '@/lib/content';

interface Props {
  locale: Locale;
  project?: Project;
}

const { locale, project } = Astro.props;
const s = t(locale);
const all = await getPosts(locale);
const posts = project ? all.filter((p) => p.entry.data.project === project.slug) : all;
const heading = project ? project.title : s.nav.blog;
const description = project ? s.blog.projectDescription(project.title) : s.blog.description;
---

<BaseLayout title={`${heading} · ${site.name}`} description={description} locale={locale}>
  <section class="page">
    <div class="side">
      <Heading as="h1" align="start">{heading}</Heading>
      {
        project && (
          <>
            <p class="lede">{description}</p>
            <p class="lede">
              <a href={localizedPath('/blog/', locale)}>{s.home.allPosts}</a>
            </p>
          </>
        )
      }
    </div>
    <PostList posts={posts} locale={locale} order={project ? 'oldest' : 'newest'} numbered={!!project} />
  </section>
</BaseLayout>

<style>
  .page {
    display: grid;
    row-gap: 32px;
    max-width: 1040px;
    margin: 0 auto;
    padding: 72px 16px 64px;
  }

  @media (min-width: 720px) {
    .page {
      grid-template-columns: 220px minmax(0, 1fr);
      column-gap: 56px;
      align-items: start;
      padding-left: 48px;
      padding-right: 48px;
    }
  }

  .side {
    margin-top: -4px;
  }

  .lede {
    max-width: 32ch;
    margin: 10px 0 0;
    font-size: 15px;
    color: var(--color-dim);
  }

  .lede + .lede {
    margin-top: 14px;
  }

  .lede a {
    color: var(--color-emphasis);
    text-decoration: none;
    border-bottom: 1px solid var(--color-magenta-glow);
  }
</style>
