---
import BaseLayout from '../../layouts/BaseLayout.astro';
import IntroScreen from '../home/IntroScreen.astro';
import ProjectsSection from '../home/ProjectsSection.astro';
import BlogSection from '../home/BlogSection.astro';
import { site } from '../../config/site';
import type { Locale } from '../../i18n/locales';
import { t } from '../../i18n/ui';
import { getPosts, getProjects } from '../../lib/content';

interface Props {
  locale: Locale;
}

const { locale } = Astro.props;
const s = t(locale);
const [posts, projects] = await Promise.all([getPosts(locale), getProjects(locale)]);
---

<BaseLayout title={site.name} description={s.home.description} locale={locale}>
  <IntroScreen locale={locale} />
  <ProjectsSection locale={locale} projects={projects} posts={posts} />
  {posts.length > 0 && <BlogSection locale={locale} posts={posts} />}
</BaseLayout>
